# Server runtime
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# Resume download filename shown to users
RESUME_FILENAME=Prasad_Kulkarni_Resume.pdf

# Contact form rate limit
CONTACT_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=10

# Inbox access key (must match client VITE_MESSAGES_VIEW_KEY)
MESSAGES_VIEW_KEY=change-me-to-a-secret

# Where contact emails are delivered (optional SMTP)
CONTACT_TO_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
